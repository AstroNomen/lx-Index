import { SlintPaperItem, SlintCategoryItem, SlintVaultItem, ThemeColors, I18nStrings } from "models.slint";
import { ListView } from "std-widgets.slint";

component HudButton inherits Rectangle {
    in-out property <string> text: "";
    in-out property <color> text-color: #2c2523;
    in-out property <color> base-bg: #e2d5c3;
    in-out property <color> hover-bg: #d5c6b0;
    in-out property <color> active-bg: #c3b299;
    in-out property <length> font-size: 12px;
    in-out property <int> font-weight: 500;
    callback clicked();

    background: touch.pressed ? root.active-bg : (touch.has-hover ? root.hover-bg : root.base-bg);
    border-radius: 6px;
    border-width: 1px;
    border-color: #c3b29944;
    animate background { duration: 120ms; }

    touch := TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }

    Text {
        text: root.text;
        color: root.text-color;
        font-size: root.font-size;
        font-weight: root.font-weight;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component TagChip inherits Rectangle {
    in-out property <string> text: "";
    in-out property <color> text-color: #2f5d8a;
    in-out property <color> base-bg: #2f5d8a14;
    in-out property <color> border-col: #2f5d8a33;
    in-out property <bool> removable: false;
    in-out property <bool> has-count: false;
    in-out property <int> count: 0;
    in-out property <bool> clickable: false;
    in-out property <length> chip-max-width: 215px;
    callback remove();
    callback clicked();

    background: root.base-bg;
    border-radius: 5px;
    border-width: 1px;
    border-color: root.border-col;
    height: 24px;
    max-width: root.chip-max-width;

    if root.clickable : TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: (root.removable || root.has-count) ? 6px : 8px;
        spacing: 5px;

        Text {
            text: root.text;
            color: root.text-color;
            font-size: 11px;
            font-weight: 500;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }

        if root.has-count : Rectangle {
            width: count-layout.preferred-width;
            height: 14px;
            border-radius: 7px;
            background: root.text-color.transparentize(82%);
            y: (parent.height - self.height) / 2;
            horizontal-stretch: 0;

            count-layout := HorizontalLayout {
                padding-left: 4px;
                padding-right: 4px;
                alignment: center;
                Text {
                    text: root.count;
                    font-size: 9px;
                    font-weight: 700;
                    color: root.text-color;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }
        }

        if root.removable : Rectangle {
            width: 14px;
            height: 14px;
            border-radius: 7px;
            background: rem-touch.has-hover ? #a83232 : root.text-color.transparentize(82%);
            animate background { duration: 100ms; }
            y: (parent.height - self.height) / 2;
            horizontal-stretch: 0;

            Image {
                source: @image-url("icons/xmark.svg");
                width: 8px;
                height: 8px;
                colorize: rem-touch.has-hover ? #ffffff : root.text-color;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }

            rem-touch := TouchArea {
                clicked => { root.remove(); }
                mouse-cursor: pointer;
            }
        }
    }
}

component SidebarItem inherits Rectangle {
    in-out property <string> title: "";
    in-out property <image> icon-src;
    in-out property <int> count: 0;
    in-out property <bool> is-active: false;
    in-out property <color> active-col: #7a434d;
    in-out property <color> text-col: #453c37;
    callback clicked();

    background: root.is-active ? root.active-col.transparentize(85%) : (s-touch.has-hover ? #0000000a : #00000000);
    border-radius: 6px;
    border-width: 1px;
    border-color: root.is-active ? root.active-col.transparentize(65%) : #00000000;
    height: 32px;
    animate background { duration: 100ms; }

    s-touch := TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        alignment: space-between;

        HorizontalLayout {
            spacing: 8px;
            alignment: start;

            Image {
                source: root.icon-src;
                width: 14px;
                height: 14px;
                image-fit: contain;
                colorize: root.is-active ? root.active-col : root.text-col;
                y: (parent.height - self.height) / 2;
            }

            Text {
                text: root.title;
                color: root.is-active ? root.active-col : root.text-col;
                font-size: 12px;
                font-weight: root.is-active ? 600 : 400;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        Rectangle {
            width: count-txt.preferred-width + 12px;
            height: 18px;
            border-radius: 9px;
            background: root.is-active ? root.active-col.transparentize(80%) : #0000000a;
            y: (parent.height - self.height) / 2;

            count-txt := Text {
                text: root.count;
                color: root.is-active ? root.active-col : #8f8078;
                font-size: 10px;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}

component TreeSelectOption inherits Rectangle {
    in-out property <bool> is-selected: false;
    in-out property <string> star-text: "";
    in-out property <string> label-text: "";
    in-out property <color> star-color: #b87b1e;
    in-out property <ThemeColors> theme;
    callback clicked();

    height: 26px;
    border-radius: 4px;
    background: opt-touch.has-hover ? root.theme.surface0 : #00000000;
    animate background { duration: 80ms; }

    opt-touch := TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;
        alignment: start;

        // Checkbox square
        Rectangle {
            width: 14px;
            height: 14px;
            border-radius: 3px;
            background: root.is-selected ? root.star-color : #00000000;
            border-width: 1px;
            border-color: root.is-selected ? root.star-color : root.theme.surface2;
            y: (parent.height - self.height) / 2;

            if root.is-selected : Image {
                source: @image-url("icons/check.svg");
                width: 10px;
                height: 10px;
                colorize: #ffffff;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }

        // Star badge
        Text {
            text: root.star-text;
            color: root.star-color;
            font-size: 11px;
            font-weight: 700;
            vertical-alignment: center;
        }

        // Description
        Text {
            text: root.label-text;
            color: root.theme.text;
            font-size: 11px;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

export component AppWindow inherits Window {
    title: root.strings.app_title;
    icon: @image-url("../assets/icon_256.png");
    min-width: 960px;
    min-height: 600px;
    preferred-width: 1280px;
    preferred-height: 800px;
    background: root.theme.base;
    default-font-family: "-apple-system, BlinkMacSystemFont, 'SF Pro Text', 'PingFang SC', 'Segoe UI', sans-serif";

    // Scholarly Warm Theme Palette (Parchment default)
    in-out property <ThemeColors> theme: {
        rosewater: #b8685e,
        flamingo: #9e4e42,
        pink: #8f4258,
        mauve: #7a434d,
        red: #a83232,
        maroon: #943838,
        peach: #b55a30,
        yellow: #b87b1e,
        green: #3e6b36,
        teal: #2d6d66,
        sky: #387d99,
        sapphire: #286b7b,
        blue: #2f5d8a,
        lavender: #65527a,
        text: #2c2523,
        subtext1: #453c37,
        subtext0: #5a4e47,
        overlay2: #756760,
        overlay1: #8f8078,
        overlay0: #a89a92,
        surface2: #c3b299,
        surface1: #d5c6b0,
        surface0: #e2d5c3,
        base: #fbf5ea,
        mantle: #f4ece1,
        crust: #ebe1d3,
        discard_bg: #6b585022,
        discard_fg: #3e2e28,
        reset_bg: #e2d5c366,
        reset_hover_bg: #e2d5c3,
        reset_border: #c3b299,
        reset_fg: #453c37
    };

    // UI Localization strings
    in-out property <I18nStrings> strings: {
        app_title: "lx Index - 文献管理 HUD",
        perspectives_header: "文献视角",
        all_items: "全部文献",
        unread: "未读",
        high_priority: "高优先级",
        discarded: "已废弃",
