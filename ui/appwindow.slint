        fields_header: "研究领域 (学科)",
        no_fields: "未检测到学科领域",
        projects_header: "关联项目",
        no_projects: "暂无关联项目",
        tags_header: "标签列表",
        search_placeholder: "搜索标题、作者、领域、标签...",
        reset_filters: "重置筛选",
        ingestion_banner: "篇未入库 PDF 位于文献库中",
        import_all: "批量入库",
        import_note: "新建笔记",
        create_note: "新建伴生笔记",
        uncatalogued_prompt_title: "未入库 PDF",
        uncatalogued_prompt_desc: "创建伴生 Markdown 笔记以持久化文献标签与元数据",
