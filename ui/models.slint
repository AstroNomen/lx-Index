export struct SlintPaperItem {
    id: string,
    filename: string,
    title: string,
    authors: string,
    year: int,
    field: string,
    projects_display: string,
    tags_display: string,
    status_code: int, // 0: Unread, 1: AiSkimmed, 2: DeepRead, 3: Discarded
    importance: int,  // 0 to 5
    summary: string,
    has_pdf: bool,
    has_note: bool,
    is_missing_pdf: bool,
}

export struct SlintPerspectiveItem {
    id: string,
    name: string,
    count: int,
    icon: string,
}

export struct SlintCategoryItem {
    name: string,
    count: int,
}

export struct SlintVaultItem {
    name: string,
    path: string,
    is_active: bool,
}

