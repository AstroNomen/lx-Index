    title: root.strings.app_title;
    icon: @image-url("../assets/icon_256.png");
    min-width: 900px;
    min-height: 560px;
    preferred-width: 1360px;
    preferred-height: 860px;
    background: root.theme.base;
    default-font-family: "'Segoe UI Variable Display', 'Segoe UI', 'Microsoft YaHei', sans-serif";

    // Dynamic Frameless Configuration (true for Windows clean Metro style, false for macOS)
    in-out property <bool> window-no-frame: true;
    no-frame: root.window-no-frame;

    // Scholarly Warm Theme Palette (Parchment default)
    in-out property <ThemeColors> theme: {
        rosewater: #b8685e,
        flamingo: #9e4e42,
        pink: #8f4258,
        mauve: #7a434d,
        red: #a83232,
