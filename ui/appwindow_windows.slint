import { SlintPaperItem, SlintCategoryItem, SlintVaultItem, ThemeColors, I18nStrings } from "models.slint";
import { ListView } from "std-widgets.slint";

// =========================================================================
// Metro UI Reusable Components (Windows 8 Modern UI Paradigm)
// =========================================================================

// Flat Metro Button
component MetroButton inherits Rectangle {
    in-out property <string> text: "";
    in-out property <color> text-color: #2c2523;
    in-out property <color> base-bg: #e2d5c3;
    in-out property <color> hover-bg: #d5c6b0;
    in-out property <color> active-bg: #c3b299;
    in-out property <color> border-col: #00000000;
    in-out property <length> font-size: 12px;
    in-out property <int> font-weight: 500;
    in-out property <image> icon-src;
    in-out property <bool> has-icon: false;
    in-out property <length> padding-h: root.has-icon ? 8px : 5px;
    callback clicked();

    background: touch.pressed ? root.active-bg : (touch.has-hover ? root.hover-bg : root.base-bg);
    border-radius: 2px;
    border-width: 1px;
    border-color: root.border-col;
    animate background { duration: 100ms; }

    touch := TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }

    HorizontalLayout {
        padding-left: root.padding-h;
        padding-right: root.padding-h;
        spacing: 5px;
        alignment: center;

        if root.has-icon : Image {
            source: root.icon-src;
            width: 13px;
            height: 13px;
            image-fit: contain;
            colorize: root.text-color;
            y: (parent.height - self.height) / 2;
        }

        if root.text != "" : Text {
            text: root.text;
            color: root.text-color;
            font-size: root.font-size;
            font-weight: root.font-weight;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

// Metro Interactive Live Tile
component MetroTile inherits Rectangle {
    in-out property <string> title: "";
    in-out property <string> count-text: "";
    in-out property <image> icon-src;
    in-out property <bool> has-icon: false;
    in-out property <bool> is-active: false;
    in-out property <color> base-bg: #e2d5c3;
    in-out property <color> hover-bg: #d5c6b0;
    in-out property <color> active-border-col: #7a434d;
    in-out property <color> text-col: #2c2523;
    callback clicked();

    background: touch.pressed ? root.base-bg.darker(10%) : (touch.has-hover ? root.hover-bg : root.base-bg);
    border-radius: 2px;
    border-width: root.is-active ? 2px : 1px;
    border-color: root.is-active ? root.active-border-col : #00000014;
    animate background { duration: 100ms; }
    animate border-color { duration: 100ms; }

    touch := TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }

    VerticalLayout {
        padding-top: 8px;
        padding-bottom: 8px;
        padding-left: 10px;
        padding-right: 10px;
        alignment: space-between;

        HorizontalLayout {
            alignment: space-between;

            if root.has-icon : Image {
                source: root.icon-src;
                width: 17px;
                height: 17px;
                image-fit: contain;
                colorize: root.text-col;
            }

            if !root.has-icon : Rectangle { width: 1px; }

            if root.count-text != "" : Text {
                text: root.count-text;
                color: root.text-col;
                font-size: 22px;
                font-weight: 300;
                vertical-alignment: top;
            }
        }

        Text {
            text: root.title;
            color: root.text-col;
            font-size: 11px;
            font-weight: 600;
            overflow: elide;
        }
    }
}

// Flat Metro Tag Chip
component MetroTagChip inherits Rectangle {
    in-out property <string> text: "";
    in-out property <color> text-color: #2f5d8a;
    in-out property <color> base-bg: #2f5d8a14;
    in-out property <color> border-col: #2f5d8a33;
    in-out property <bool> removable: false;
    in-out property <bool> has-count: false;
    in-out property <int> count: 0;
    in-out property <bool> clickable: false;
    in-out property <length> chip-max-width: 215px;
    callback remove();
    callback clicked();

    background: root.base-bg;
    border-radius: 2px;
    border-width: 1px;
    border-color: root.border-col;
    height: 22px;
    max-width: root.chip-max-width;

    if root.clickable : TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }

    HorizontalLayout {
        padding-left: 7px;
        padding-right: 7px;
        spacing: 5px;

        Text {
            text: root.text;
            color: root.text-color;
            font-size: 11px;
            font-weight: 500;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }

        if root.has-count : Rectangle {
            width: count-layout.preferred-width;
            height: 14px;
            border-radius: 7px;
            background: root.text-color.transparentize(82%);
            y: (parent.height - self.height) / 2;
            horizontal-stretch: 0;

            count-layout := HorizontalLayout {
                padding-left: 4px;
                padding-right: 4px;
                alignment: center;
                Text {
                    text: root.count;
                    font-size: 9px;
                    font-weight: 700;
                    color: root.text-color;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }
        }

        if root.removable : Rectangle {
            width: 14px;
            height: 14px;
            border-radius: 7px;
            background: rem-touch.has-hover ? #a83232 : #00000018;
            animate background { duration: 100ms; }
            y: (parent.height - self.height) / 2;
            horizontal-stretch: 0;

            Image {
                source: @image-url("icons/win-close.svg");
                width: 7px;
                height: 7px;
                colorize: rem-touch.has-hover ? #ffffff : root.text-color;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }

            rem-touch := TouchArea {
                clicked => { root.remove(); }
                mouse-cursor: pointer;
            }
        }
    }
}

// Metro App Bar Action Button (Circular Outline Windows 8 Modern Button)
component MetroAppBarButton inherits Rectangle {
    in-out property <string> label: "";
    in-out property <image> icon-src;
    in-out property <color> icon-color: #2c2523;
    in-out property <color> label-color: #2c2523;
    in-out property <color> circle-border: #756760;
    in-out property <color> hover-bg: #7a434d;
    in-out property <color> hover-icon-color: #fbf5ea;
    in-out property <bool> is-active: false;
    callback clicked();

    width: 48px;
    height: 52px;
    background: #00000000;

    touch := TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }

    VerticalLayout {
        alignment: center;
        padding-top: 5px;
        padding-bottom: 5px;
        spacing: 3px;

        // Circular outlined button with hover inversion
        Rectangle {
            width: 28px;
            height: 28px;
            border-radius: 14px;
            border-width: 1.5px;
            border-color: (root.is-active || touch.has-hover) ? root.hover-bg : root.circle-border;
            background: (root.is-active || touch.has-hover) ? root.hover-bg : #00000000;
            animate background { duration: 100ms; }
            animate border-color { duration: 100ms; }
            x: (parent.width - self.width) / 2;

            Image {
                source: root.icon-src;
                width: 13px;
                height: 13px;
                image-fit: contain;
                colorize: (root.is-active || touch.has-hover) ? root.hover-icon-color : root.icon-color;
                animate colorize { duration: 100ms; }
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }

        if root.label != "" : Text {
            text: root.label;
            color: root.label-color;
            font-size: 9px;
            font-weight: 500;
            horizontal-alignment: center;
        }
    }
}

// Metro Star Select Option
component TreeSelectOption inherits Rectangle {
    in-out property <bool> is-selected: false;
    in-out property <string> star-text: "";
    in-out property <string> label-text: "";
    in-out property <color> star-color: #b87b1e;
    in-out property <ThemeColors> theme;
    callback clicked();

    height: 28px;
    border-radius: 2px;
    background: opt-touch.has-hover ? root.theme.surface0 : #00000000;
    animate background { duration: 80ms; }

    opt-touch := TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        alignment: start;

        // Metro square checkbox
        Rectangle {
            width: 14px;
            height: 14px;
            border-radius: 1px;
            background: root.is-selected ? root.star-color : #00000000;
            border-width: 1px;
            border-color: root.is-selected ? root.star-color : root.theme.surface2;
            y: (parent.height - self.height) / 2;

            if root.is-selected : Image {
                source: @image-url("icons/check.svg");
                width: 10px;
                height: 10px;
                colorize: #ffffff;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }

        Text {
            text: root.star-text;
            color: root.star-color;
            font-size: 11px;
            font-weight: 700;
            vertical-alignment: center;
        }

        Text {
            text: root.label-text;
            color: root.theme.text;
            font-size: 11px;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

// =========================================================================
// Main Desktop Window (Modern 3-Pane Architecture with Metro Pivot & Tiles)
// =========================================================================

